    calories: number;
    protein: number;
    carbs: number;
    fat: number;
    fiber: number;
  };
  tags: string[];
  cuisine: string;
  rating: number;
  reviews: number;
  cost: number;
  isFavorite?: boolean;
  isUserCreated?: boolean;
  isPopular?: boolean;
}

