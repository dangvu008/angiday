// Dữ liệu cho các thực đơn theo chủ đề
export const menuThemes = {
  budget: mockRecipes.filter(r => r.cost <= 50000),
  quick: mockRecipes.filter(r => parseInt(r.cookingTime) <= 30),
  healthy: mockRecipes.filter(r => r.nutrition.calories <= 250),
  family: mockRecipes.filter(r => r.isPopular || r.rating >= 4.5)
};

// Dữ liệu cho sổ tay cá nhân
export const personalRecipes = {
  favorites: mockRecipes.filter(r => r.isFavorite),
  userCreated: mockRecipes.filter(r => r.isUserCreated),
  recent: mockRecipes.slice(0, 4)
};
